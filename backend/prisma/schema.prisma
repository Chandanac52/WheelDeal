generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  password  String?
  name      String
  phone     String?  @unique
  avatar    String?
  role      UserRole @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Which dealer (if any) this account is authorized to sell on behalf of.
  // Deliberately account-level, not per-listing: an individual seller is
  // just a User with dealerId = null, and a dealer-affiliated seller is a
  // User linked to exactly one Dealer. Nothing in the API currently lets a
  // user set this on themselves — it's only ever written directly (seed
  // data today; an admin "Verify Dealer" action in a future admin panel).
  // POST /vehicles derives a new listing's dealerId from THIS field on the
  // authenticated user, never from client-supplied input — that's what
  // makes it impossible to list a vehicle under a dealer you're not
  // actually linked to.
  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  vehicles  Vehicle[]
  favorites Favorite[]
  sentMessages     Message[] @relation("SentMessages")
  chatParticipants ChatParticipant[]
  callbackRequests CallbackRequest[]
  notifications    Notification[]
  // Reviews this user has LEFT on dealers, as a buyer. Not reviews of
  // them — a User has no reviews-received relation of their own; only a
  // Dealer does (see Dealer.reviews below). See Review model for why.
  reviews          Review[]
}

enum UserRole {
  BUYER
  SELLER
  DEALER
  ADMIN
}

model Dealer {
  id         String   @id @default(cuid())
  name       String
  logo       String?
  totalCars  Int      @default(0)
  location   String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  vehicles Vehicle[]
  // Accounts authorized to sell on behalf of this dealer — see User.dealerId.
  users    User[]
  // Ratings buyers have actually left for this dealer. There used to be a
  // `rating Float @default(4.5)` column directly on this model — a number
  // nobody ever set and nothing ever updated, so every dealer just showed
  // whatever value seed data happened to type in. A rating is only
  // meaningful once someone with a real transaction has given it, so it's
  // now this relation instead: dealers.js computes the live average +
  // count from these rows on every request (the same "compute fresh, never
  // store a stale number" pattern already used for isFeatured and soldCount
  // in vehicles.js), and a dealer with zero reviews honestly shows as
  // unrated rather than defaulting to a fake 4.5.
  //
  // Deliberately NOT on Vehicle: a star rating only makes sense once
  // someone has actually dealt with the seller — you can't honestly rate a
  // listing before buying the vehicle it's for, and OLX-style marketplaces
  // don't pretend otherwise. Individual (non-dealer) sellers also have no
  // rating anywhere for the same reason: this relation only attaches to
  // Dealer, not User.
  reviews    Review[]
}

// One buyer's rating of one dealer, based on having actually dealt with
// them (chatted, called, or bought). @@unique below caps it at one review
// per (dealer, buyer) — submitting again is an UPDATE to their existing
// review (see the upsert in dealers.js), not a second row, so one person
// spamming 1-star reviews can't tank a dealer's average by repetition.
model Review {
  id        String   @id @default(cuid())
  dealerId  String
  buyerId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  buyer  User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, buyerId])
  @@index([dealerId])
}

model Vehicle {
  id              String   @id @default(cuid())
  name            String
  category        String
  images          String[]
  price           Int
  originalPrice   Int?
  discountPercent Int?
  isFeatured      Boolean  @default(false)
  fuelType        String
  transmission    String
  year            String
  seats           String
  kmDriven        String
  owners          String
  condition       String
  insurance       String
  // The actual date insurance stops being valid — separate from the
  // human-readable `insurance` string above ("Valid till 12 Dec 2027"),
  // which exists purely for display and is NOT machine-parseable safely.
  // This is what the expiry sweep (services/listingExpiry.js) actually
  // checks against — a real Date column, queryable and indexable, instead
  // of parsing a display string. Null means "no expiry tracked" (covers
  // "Expired" / "Not Available" insurance statuses, and any older listing
  // created before this field existed) — those are simply never touched
  // by the sweep, not treated as already-expired.
  insuranceValidTill DateTime?
  rcStatus        String
  soldCount       String   @default("0")
  description     String
  location        String
  sellerName      String
  sellerPhone     String
  sellerAvatar    String?
  dealerVerified  Boolean  @default(false)
  status          VehicleStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sellerId String?
  seller   User?   @relation(fields: [sellerId], references: [id])
  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  // Both of these already cascade on delete (onDelete: Cascade below), so
  // DELETE /vehicles/:id (vehicles.js) can remove a Vehicle row directly —
  // Prisma/Postgres cleans up every Favorite and CallbackRequest that
  // pointed at it in the same transaction, with no manual cleanup query
  // needed and no risk of the delete failing on a leftover foreign key.
  // Notification.relatedVehicleId is intentionally NOT a relation (just a
  // plain String below), specifically so a vehicle can always be deleted
  // without ever being blocked by, or needing to touch, notification rows.
  favorites        Favorite[]
  callbackRequests CallbackRequest[]

  // Speeds up the two most common queries: browsing/filtering the active
  // feed by category, and sorting the newest active listings first.
  @@index([status, category])
  @@index([status, createdAt])
  // Lets the expiry sweep (services/listingExpiry.js) find "ACTIVE
  // listings whose insurance date has passed" without a full table scan —
  // it queries exactly this pair (status = ACTIVE, insuranceValidTill in
  // the past) on every run.
  @@index([status, insuranceValidTill])
}

enum VehicleStatus {
  ACTIVE
  SOLD
  PENDING
  REJECTED
  // A listing the expiry sweep took down automatically because its
  // insurance date passed while it was still ACTIVE and unsold — distinct
  // from SOLD (a completed transaction) and from REJECTED (an admin
  // moderation action that doesn't exist yet). Like SOLD, it's excluded
  // from every public query (Home, Search, dealer profiles all filter to
  // status: 'ACTIVE') but still shows up in the seller's own My Listings,
  // where they can update the insurance date via Edit and relist it — see
  // the guard on PUT /:id/status in vehicles.js that stops a relist from
  // going through until the date is actually fixed.
  EXPIRED
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
}

model Chat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     Message[]
}

model ChatParticipant {
  id     String @id @default(cuid())
  chatId String
  userId String

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model Message {
  id        String    @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime  @default(now())
  read      Boolean   @default(false)
  edited    Boolean   @default(false)
  deleted   Boolean   @default(false)

  chat          Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender        User           @relation("SentMessages", fields: [senderId], references: [id])
  notifications Notification[]

  @@index([chatId, createdAt])
}

model CallbackRequest {
  id        String   @id @default(cuid())
  vehicleId String
  userId    String
  phone     String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  // Was missing onDelete: Cascade entirely (defaulted to RESTRICT) — this
  // is exactly what caused "violates RESTRICT setting of foreign key
  // constraint CallbackRequest_vehicleId_fkey" when the seed script tried
  // to delete a vehicle that had a callback request pointing at it.
  // Favorite/ChatParticipant/Message all already cascade correctly
  // elsewhere in this schema; this brings CallbackRequest in line with them.
  // This is also what makes DELETE /vehicles/:id safe today.
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String   @id @default(cuid())
  userId           String
  // 'message' | 'price_drop' | 'callback' | 'sold' | 'expired' | 'system'
  type             String
  title            String
  body             String
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())
  relatedVehicleId String?
  relatedChatId    String?
  // Links a 'message'-type notification to the specific Message it was
  // generated from. Two things depend on this: (1) collapsing several
  // rapid messages in the same still-unread conversation into one updating
  // notification instead of a new row per message, and (2) keeping the
  // notification's `body` in sync if that message is later edited or
  // deleted — without this link there was nothing to even go find and fix
  // when a message changed after the fact.
  messageId        String?
  // The phone number to show the seller for a 'callback' notification —
  // separate from the requester's account phone since they can supply a
  // different reachable number when requesting the callback.
  relatedPhone     String?
  // The buyer/requester this notification is about — currently only set
  // for 'callback' notifications, where it identifies WHO is asking to be
  // called back (as opposed to `userId`, which is always the recipient,
  // i.e. the seller). This is what lets repeated callback requests from
  // the SAME buyer about the SAME vehicle collapse into one updating row
  // (see the second @@unique below and the upsert in vehicles.js), while a
  // request from a DIFFERENT buyer always gets its own separate row —
  // the seller never has to guess who a given notification is about.
  relatedUserId    String?
  // How many times this notification has fired without being replaced by
  // a new row. Currently only meaningful for 'callback' notifications —
  // incremented on every repeat request from the same buyer about the
  // same vehicle (see vehicles.js). The Notifications screen shows this as
  // "Callback requested (N)" once it passes 1, so the seller can see at a
  // glance how many times someone's tried to reach them, instead of the
  // list just filling up with N near-identical rows for the same person.
  count            Int      @default(1)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  // At most one 'message'-type notification per (recipient, chat) — this is
  // what makes the Notifications screen behave like every other chat app's
  // notification list: one entry per conversation that keeps updating and
  // reappearing as unread, not a growing history log of every message ever
  // sent. relatedChatId is NULL for 'price_drop'/'callback' notifications,
  // and Postgres treats NULLs as distinct for uniqueness purposes, so this
  // constraint has no effect on those — only 'message' rows are deduped.
  @@unique([userId, relatedChatId, type])
  // Same idea, for 'callback' notifications: at most one row per (seller,
  // vehicle, requester) — repeat callback requests from the same buyer
  // about the same vehicle update this one row (and bump `count`) instead
  // of piling up as separate rows. relatedVehicleId/relatedUserId are NULL
  // on 'message'/'price_drop' rows, and Postgres treats NULLs as distinct,
  // so this constraint has no effect on those — only 'callback' rows are
  // deduped, and only against the same requester.
  @@unique([userId, relatedVehicleId, relatedUserId, type])
  @@index([userId, createdAt])
}
