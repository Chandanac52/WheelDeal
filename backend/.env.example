# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=3000
NODE_ENV=development

# Database — PostgreSQL (recommended for production)
# Create a free DB at: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wheeldeal?schema=public"

# For local dev without PostgreSQL, use SQLite instead:
# DATABASE_URL="file:./dev.db"

# JWT — generate a strong random string (min 32 chars)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=7d

# CORS — your Flutter app origin (use * only in dev)
CORS_ORIGIN=*

# File uploads (local storage for MVP; swap to S3/Cloudinary later)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Phone OTP login (Firebase Phone Auth) — the backend verifies the ID token
# the app gets after the user confirms their SMS code. Get this JSON from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# Locally: save the downloaded file as backend/firebase-service-account.json instead
# (gitignored) and leave this var unset.
# In production (Railway/Render): paste the whole JSON file's contents here as one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
